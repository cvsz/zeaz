{
  "name": "moopiew",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@9.2.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo build",
    "lint": "bash scripts/lint.sh",
    "test": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "typecheck": "turbo typecheck",
    "validate": "npm run lint && npm run typecheck && npm run build && npm test",
    "dashboard": "python3 -m dashboard.api.server",
    "publish:platform": "bash scripts/publish-platform.sh",
    "validate:packages": "npm run typecheck"
  },
  "devDependencies": {"turbo": "^2.3.3", "typescript": "^7.0.2", "@types/node": "^26.1.2", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0"}
}
