# Dashboard reverse-proxy defense in depth. Keep the real file mode 0600.
PIEWDASH_BASIC_AUTH_USER=operator
# Generate a random password and its Caddy bcrypt hash:
# password="$(openssl rand -base64 32)"
# caddy hash-password --plaintext "$password"
PIEWDASH_BASIC_AUTH_PASSWORD='replace-with-a-random-password'
PIEWDASH_BASIC_AUTH_HASH='$2a$14$replace-with-caddy-bcrypt-hash'
