# Hugging Face Inference Providers. Copy this to ignored .env.ai (chmod 600),
# then load it in the service environment. Never expose HF_TOKEN to browsers.
HF_ENABLED=false
HF_TOKEN=replace-with-a-hugging-face-token-with-inference-providers-permission
# The service accepts only the official Router endpoint to prevent SSRF.
HF_ROUTER_BASE_URL=https://router.huggingface.co/v1
# Cache the Router model catalog locally; it is refreshed on expiry.
HF_MODEL_CATALOG_TTL=300
# Optional multi-provider catalog. Each provider is enabled only when its key
# is present. Store provider keys in this one ignored file, never in source.
AI_PROVIDER_KEYS_JSON='{"gemini":"replace-with-gemini-key","nvidia":"replace-with-nvidia-key","zai":"replace-with-zai-key","opencode":"replace-with-opencode-zen-key","openrouter":"replace-with-openrouter-key","groq":"replace-with-groq-key","byteplus":"replace-with-byteplus-modelark-key"}'
