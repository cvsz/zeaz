# Hugging Face Inference Providers. Copy this to ignored .env.ai (chmod 600),
# then load it in the service environment. Never expose HF_TOKEN to browsers.
HF_ENABLED=false
HF_TOKEN=replace-with-a-hugging-face-token-with-inference-providers-permission
# The service accepts only the official Router endpoint to prevent SSRF.
HF_ROUTER_BASE_URL=https://router.huggingface.co/v1
# Cache the Router model catalog locally; it is refreshed on expiry.
HF_MODEL_CATALOG_TTL=300
# Optional ZeaZ Provider gateway. It is safe only when the URL is HTTPS, or
# HTTP on localhost. Generate a dedicated gateway client key; never reuse a
# provider API key and never expose this value to the browser.
ZEAZ_AI_GATEWAY_URL=http://127.0.0.1:8081/v1
AI_GATEWAY_PROVIDER_TOKEN=replace-with-a-dedicated-zeaz-gateway-client-key
# Optional multi-provider catalog. Each provider is enabled only when its key
# is present. Store provider keys in this one ignored file, never in source.
AI_PROVIDER_KEYS_JSON='{"gemini":"replace-with-gemini-key","nvidia":"replace-with-nvidia-key","zai":"replace-with-zai-key","opencode":"replace-with-opencode-zen-key","openrouter":"replace-with-openrouter-key","groq":"replace-with-groq-key","byteplus":"replace-with-byteplus-modelark-key","fireworks":"replace-with-fireworks-key","openai":"replace-with-openai-key","kimi":"replace-with-kimi-key","scaleway":"replace-with-scaleway-key","together":"replace-with-together-key"}'
# Optional OpenAI-compatible local model server (Ollama, llama.cpp, LM Studio or vLLM).
# HTTP is accepted only on loopback; remote endpoints must use HTTPS.
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=llama3.2
LOCAL_AI_API_KEY=
# Optional GitHub Models and Cerebras credentials. They are routed after Together.
# Add github/cerebras entries to AI_PROVIDER_KEYS_JSON when enabled.
