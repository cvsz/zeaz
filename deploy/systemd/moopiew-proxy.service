[Unit]
Description=Moopiew loopback Caddy reverse proxy
After=network-online.target moopiew.service
Wants=network-online.target
Requires=moopiew.service
Before=moopiew-cloudflared.service

[Service]
Type=simple
WorkingDirectory=/home/cvsz/zeaz
ExecStart=/usr/bin/caddy run --environ --config /home/cvsz/zeaz/deploy/caddy/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /home/cvsz/zeaz/deploy/caddy/Caddyfile --adapter caddyfile
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
