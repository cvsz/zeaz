[Unit]
Description=Moopiew preorder application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/cvsz/zeaz
EnvironmentFile=/home/cvsz/zeaz/.env.production
EnvironmentFile=-/home/cvsz/zeaz/.env.payment
EnvironmentFile=-/home/cvsz/zeaz/.env.ai
ExecStart=/usr/bin/python3 /home/cvsz/zeaz/app.py
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/cvsz/zeaz/data

[Install]
WantedBy=default.target
