[Unit]
Description=MooPiew encrypted document retention
After=moopiew.service

[Service]
Type=oneshot
WorkingDirectory=%h/zeaz
EnvironmentFile=%h/zeaz/.env.production
ExecStart=%h/zeaz/.venv/bin/python %h/zeaz/scripts/document-storage.py purge
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=%h/zeaz/data
