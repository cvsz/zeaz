# Copy to /home/cvsz/zeaz/.env.arin on the origin host and keep mode 0600.
ARIN_DATA_DIR=/home/cvsz/zeaz/data/arin
ARIN_HOST=127.0.0.1
ARIN_PORT=8787
ARIN_SESSION_DAYS=30

# Generate once with:
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ARIN_CONNECTOR_KEY=replace-with-a-fernet-key

# Optional OpenAI-compatible provider. Empty values use the local generator.
ARIN_AI_BASE_URL=
ARIN_AI_API_KEY=
ARIN_AI_MODEL=
