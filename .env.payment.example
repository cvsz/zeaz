# Payment configuration template. Copy to .env.payment, fill with bank-issued
# credentials, chmod 600 .env.payment, and keep all *_ENABLED values false
# until UAT, return URLs, and webhook verification are complete.

PAYMENTS_ENABLED=false
PAYMENT_ENVIRONMENT=sandbox

# Set true only when capacity and fulfilment operations are ready for automatic confirmation.
# This never marks a payment as paid.
AUTO_CONFIRM_ORDERS=false

# PromptPay QR (use a mobile number, national ID, or e-wallet ID issued to you)
PROMPTPAY_ENABLED=false
PROMPTPAY_ID=replace-with-promptpay-id
PROMPTPAY_DISPLAY_NAME=Moopiew

# SCB Payment Gateway / Mae Manee
# Product must be approved for this merchant: redirect_api, qr_api, or payment_link.
SCB_ENABLED=false
# Comma-separated products approved for this merchant. Keep every product
# disabled until its own Sandbox/UAT contract has passed.
SCB_ENABLED_PRODUCTS=maemanee_qr
SCB_PRODUCT=qr_api
SCB_APPLICATION_NAME=MooPiew
SCB_PUBLIC_DESCRIPTION="Moopiew - AI-powered restaurant ordering and food delivery platform."
SCB_OAUTH_CALLBACK_URL=https://moopiew.zeaz.dev/auth/scb/callback
SCB_MERCHANT_NAME_CREDIT_CARD=MOOPIEW
SCB_MERCHANT_NAME_DIRECT_DEBIT=MOOPIEW
SCB_BILLER_NAME=MOOPIEW
SCB_REQUIRE_CVV=true
SCB_PAYMENT_CONFIRMATION_URL=https://moopiew.zeaz.dev/api/scb/payment/confirm
SCB_DIRECT_DEBIT_REGISTRATION_CALLBACK_URL=https://moopiew.zeaz.dev/api/scb/direct-debit/register/callback
SCB_DIRECT_DEBIT_PAYMENT_CALLBACK_URL=https://moopiew.zeaz.dev/api/scb/direct-debit/payment/callback
SCB_MERCHANT_ID=replace-with-scb-merchant-id
SCB_BILLER_ID=replace-with-scb-biller-id
SCB_TERMINAL_ID=replace-with-scb-terminal-id
SCB_DIRECT_DEBIT_MERCHANT_ID=replace-with-scb-direct-debit-merchant-id
SCB_DIRECT_DEBIT_SUB_ACCOUNT_ID=replace-with-scb-direct-debit-sub-account-id
SCB_DIRECT_DEBIT_MERCHANT_ACCOUNT=replace-with-scb-direct-debit-merchant-account
# Base64-encoded SCB RSA public key downloaded from Merchant Information.
# Keep the file out of git; never place a private key in this repository.
SCB_DIRECT_DEBIT_ENCRYPTION_PUBLIC_KEY_FILE=./.public.pub
SCB_CORPORATE_ID=replace-with-scb-corporate-id
SCB_OBJECTIVE_CODE=replace-with-scb-objective-code
SCB_MTLS_REQUIRED=true
SCB_CLIENT_CERT_FILE=./secrets/scb/certificate.crt
SCB_CLIENT_KEY_FILE=./secrets/scb/privateKey.pem
SCB_QR_TYPE=PP
SCB_REF1=replace-with-reference-1
SCB_REF2=replace-with-reference-2
SCB_REF3=replace-with-reference-3
SCB_SANDBOX_INVOICE=replace-with-sandbox-invoice
SCB_API_KEY=replace-with-scb-api-key
SCB_API_SECRET=replace-with-scb-api-secret
SCB_WEBHOOK_SECRET=replace-with-scb-webhook-secret
# Set this only from SCB's signed-callback specification; do not accept unsigned callbacks.
SCB_WEBHOOK_SIGNATURE_HEADER=X-SCB-Signature
SCB_API_BASE_URL=https://replace-with-scb-uat-or-production-base-url
SCB_OAUTH_MODE=authorization_code
# Owner/profile authorization uses the authorization-code grant. Merchant
# payment APIs use a separate service token by default; do not reuse a customer
# consent token for QR, deeplink, e-wallet, direct-debit or transfer requests.
SCB_PAYMENT_OAUTH_MODE=client_credentials
# Generate once with: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SCB_TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key-kept-out-of-git
SCB_OAUTH_TOKEN_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/oauth/token
SCB_OAUTH_REFRESH_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/oauth/token/refresh
SCB_AUTHORIZE_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v2/oauth/authorize

# Mae Manee QR / PromptPay (the only checkout product currently implemented).
SCB_MAEMANEE_QR_ENABLED=false
SCB_QR_CREATE_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/maemanee/payment/qr/create
# Inquiry endpoints must match the SCB product that created the payment. The
# placeholders in braces are substituted only by the corresponding provider adapter.
SCB_QR_INQUIRY_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/maemanee/payment/transaction/getone
SCB_BILLPAYMENT_INQUIRY_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/billpayment/transactions/{transRef}?{param}={value}
SCB_QRCS_INQUIRY_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/qrcode/creditcard/{qrId}
SCB_EWALLET_INQUIRY_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/ewallets/inquire
SCB_EASY_TRANSACTION_INQUIRY_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v2/transactions/{transactionId}
SCB_QR_RECONCILIATION_ENDPOINT=https://replace-with-scb-uat-or-production-qr-reconciliation-endpoint
SCB_QR_PAYMENT_TYPES=T30
# SCB standard QR, QR CS and Bill Payment. Set each feature gate only after SCB
# has approved the corresponding product and its request/response schema.
SCB_STANDARD_QR_ENABLED=false
SCB_QR_V1_CREATE_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/qrcode/create
SCB_QR_V2_CREATE_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v2/payment/qrcode/create
SCB_QR30_ENABLED=false
SCB_QR30_CREATE_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v2/payment/qrcode/create
SCB_QRCS_ENABLED=false
SCB_QR_VOID_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/qrcode/void
SCB_BILLPAYMENT_ENABLED=false
SCB_BILLPAYMENT_INQUIRY_V3_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v3/payment/billpayment/inquiry
SCB_BILLPAYMENT_INQUIRY_V1_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/billpayment/inquiry?{param}={value}

# SCB EASY App deeplink payments.
SCB_DEEPLINK_ENABLED=false
SCB_DEEPLINK_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v3/deeplink/transactions
SCB_TRANSACTION_LOOKUP_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v2/transactions/{transactionId}

# Alipay+ and WeChatPay. These operations are intentionally disabled until the
# merchant is entitled and a separate e-wallet create adapter is implemented.
SCB_EWALLET_ENABLED=false
SCB_EWALLET_QR_CREATE_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/ewallets/qrcode/create
SCB_EWALLET_CANCEL_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/ewallets/cancel
SCB_EWALLET_QR_CANCEL_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/ewallets/qrcode/cancel
SCB_EWALLET_REFUND_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/ewallets/refund
SCB_EWALLET_PAY_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/ewallets/pay

# B Scan C confirmation/refund.
SCB_RTP_ENABLED=false
SCB_RTP_CONFIRM_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/merchant/rtp/confirm
SCB_RTP_REFUND_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/merchant/rtp/refund

# Direct Debit and API Credit / Debit Transfer. These are host-to-host products;
# keep their callbacks registered, authenticated and separate from QR callbacks.
SCB_DIRECT_DEBIT_ENABLED=false
SCB_DIRECT_DEBIT_WEB_INIT_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/registration/web/init
SCB_DIRECT_DEBIT_REGISTRATION_INQUIRY_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/registration/inquiry
SCB_DIRECT_DEBIT_DIRECT_PAY_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/direct/ddpay
SCB_DIRECT_DEBIT_WEB_PAY_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/web/ddpay
SCB_DIRECT_DEBIT_PAYMENT_INQUIRY_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/inquiry
SCB_TRANSFER_ENABLED=false
SCB_TRANSFER_CREDIT_INITIATE_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/transfer/fcd/credit/initiate
SCB_TRANSFER_CREDIT_CONFIRM_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/transfer/fcd/credit/confirm
SCB_TRANSFER_DEBIT_INITIATE_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/transfer/fcd/debit/initiate
SCB_TRANSFER_DEBIT_CONFIRM_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/transfer/fcd/debit/confirm
SCB_TRANSFER_INQUIRY_ENDPOINT=https://api-sandbox.partners.scb/partners/sandbox/v1/payment/transfer/fcd/inquiry
SCB_RETURN_URL=https://moopiew.zeaz.dev/auth/scb/callback
SCB_WEBHOOK_URL=https://moopiew.zeaz.dev/api/scb/payment/confirm

# KBank K-Payment Gateway / K SHOP
KSHOP_ENABLED=false
KSHOP_MERCHANT_ID=replace-with-kbank-merchant-id
KSHOP_API_KEY=replace-with-kbank-api-key
KSHOP_API_SECRET=replace-with-kbank-api-secret
KSHOP_WEBHOOK_SECRET=replace-with-kbank-webhook-secret
KSHOP_API_BASE_URL=https://replace-with-kbank-uat-or-production-base-url
KSHOP_RETURN_URL=https://moopiew.zeaz.dev/payment/kshop/return
KSHOP_WEBHOOK_URL=https://moopiew.zeaz.dev/api/payments/kshop/webhook
