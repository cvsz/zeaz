{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeaz.dev/schemas/zerp-codex-audit.schema.json",
  "title": "ZERP Codex Audit Ledger",
  "type": "object",
  "required": ["schemaVersion", "repository", "head", "generatedAt", "items"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "repository": {"type": "string", "minLength": 1},
    "head": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "path", "severity", "status", "evidence", "validation"],
        "properties": {
          "id": {"type": "string", "pattern": "^ZERP-[A-Z0-9_-]+-[0-9]{4}$"},
          "category": {"type": "string"},
          "path": {"type": "string"},
          "severity": {"enum": ["P0", "P1", "P2", "P3"]},
          "status": {"enum": ["missing", "broken", "invalid", "incomplete", "unsafe", "obsolete", "blocked", "deferred", "complete"]},
          "evidence": {"type": "string", "minLength": 1},
          "validation": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "completionEvidence": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
