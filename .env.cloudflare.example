# Cloudflare/Terraform configuration modelled after z-platform.
# Copy to .env.cloudflare, fill every secret locally, then chmod 600 it.
# Never commit the populated file.

# Required by Terraform and the Cloudflare API. Use a scoped token limited to
# the zeaz.dev zone and existing tunnel: Zone DNS Edit, Tunnel Read/Edit, and
# Account Access: Apps and Policies Edit. ZEAZ One's API path additionally
# requires Workers Scripts Write and Workers Routes Write.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_ID=
PIEWDASH_ACCESS_ALLOWED_EMAILS='["operator@example.com"]'

# Optional dedicated zDash allowlist. When omitted, Terraform inherits the
# PIEWDASH_ACCESS_ALLOWED_EMAILS set above.
ZDASH_ACCESS_ALLOWED_EMAILS=

# Terraform state remains local until a private R2 bucket and bucket-scoped S3
# access pair are ready. Migration additionally requires ALLOW_R2_WRITE=true.
TERRAFORM_BACKEND_TYPE=local
ALLOW_R2_WRITE=false
MANAGE_TUNNEL_CONFIG=false
TERRAFORM_STATE_BUCKET=
CLOUDFLARE_S3_API_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_ACCESS_SECRET_KEY=

# Required only by cloudflared on the origin host. Do not give this to Terraform.
CLOUDFLARE_TUNNEL_TOKEN=

# Moopiew application route. Keep this public route outside Cloudflare Access.
MOOPIEW_HOSTNAME=moopiew.zeaz.dev
MOOPIEW_ORIGIN=http://127.0.0.1:8080

# Arin static marketing site through the reviewed Caddy static root.
ARIN_HOSTNAME=arin.zeaz.dev
ARIN_ORIGIN=http://127.0.0.1:8080

# zttshop public app route through the reviewed app origin.
ZTTSHOP_HOSTNAME=zttshop.zeaz.dev
ZTTSHOP_ORIGIN=http://127.0.0.1:8080

# NextChat public chat route. qwen-gen-nextchat-1 publishes host port 3000;
# the secondary Open WebUI instance, when enabled, uses host port 3011.
CHAT_HOSTNAME=chat.zeaz.dev
CHAT_ORIGIN=http://127.0.0.1:3000

# LLM Wiki frontend. Port 5173 serves the built preview; port 5174 is a
# secondary development instance and is intentionally not routed by this host.
LLMWIKI_HOSTNAME=llmwiki.zeaz.dev
LLMWIKI_ORIGIN=http://127.0.0.1:5173

# zksato API/dashboard. PostgreSQL and Redis remain internal Compose services.
ZKSATO_HOSTNAME=zksato.zeaz.dev
ZKSATO_ORIGIN=http://127.0.0.1:9569

# zWorkforce authenticated API origin.
ZWF_HOSTNAME=zwf.zeaz.dev
ZWF_ORIGIN=http://127.0.0.1:9570

# Protected engineering dashboard route. This must target Caddy on port 80,
# never the dashboard process on port 8082, so Basic Auth cannot be bypassed.
PIEWDASH_HOSTNAME=piewdash.zeaz.dev
PIEWDASH_ORIGIN=http://127.0.0.1:80

# Protected zDash operations dashboard. cloudflared connects directly to the
# loopback-only zDash gateway introduced by cvsz/zdash PR #55.
ZDASH_HOSTNAME=zdash.zeaz.dev
ZDASH_ORIGIN=http://127.0.0.1:18080

# zERP public route through Caddy; never expose port 3001 directly.
ZERP_HOSTNAME=zerp.zeaz.dev
ZERP_ORIGIN=http://127.0.0.1:80

# CME Pro ERP API route. The active ZEAZ/CME Python service listens on 8000.
CMEERP_HOSTNAME=cme.zeaz.dev
CMEERP_ORIGIN=http://127.0.0.1:8000

# U.Perfect Social Commerce OS. The service runs from /mnt/uperfect.
UPERFECT_HOSTNAME=uperfect.zeaz.dev
UPERFECT_ORIGIN=http://192.168.74.130:18765

# ZOK Social Commerce dashboard. The public route terminates at the Vite UI;
# its /api proxy reaches the private Node API on localhost:3005.
ZOK_HOSTNAME=zok.zeaz.dev
ZOK_ORIGIN=http://127.0.0.1:5175

# z-spark static client through Caddy. Caddy serves /mnt/z-spark/client/dist
# and proxies /api/* to the private Node backend on 127.0.0.1:13131.
Z_SPARK_HOSTNAME=z-spark.zeaz.dev
Z_SPARK_ORIGIN=http://127.0.0.1:8080

# ZEAZ One is disabled by default. scripts/zeaz-one-sync.sh explicitly enables
# the resources during its ZEAZ One plan/apply operations. api.zeaz.dev remains
# the existing shared API hostname; only /v1/products/zeaz-one* is attached.
# www.zeaz.dev is owned and deployed by cvsz/zeaz-platform.
ZEAZ_ONE_ENABLED=false
ZEAZ_ONE_API_ROUTE_ENABLED=false
ZEAZ_ONE_HOSTNAME=one.zeaz.dev
ZEAZ_ONE_ORIGIN=http://127.0.0.1:18081
ZEAZ_ONE_API_HOSTNAME=api.zeaz.dev
ZEAZ_ONE_API_ORIGIN=http://127.0.0.1:18084
ZEAZ_ONE_SUPPORT_HOSTNAME=support.zeaz.dev
ZEAZ_ONE_SUPPORT_ORIGIN=http://127.0.0.1:18083

# Optional: override the bundled tools/bin/terraform location.
TERRAFORM_BIN=
