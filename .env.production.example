# Production runtime configuration. Copy to .env.production and chmod 600.
PORT=8000
HOST=127.0.0.1
# SQLite is the supported durable database for this single-instance deployment.
# Keep both paths inside the systemd ReadWritePaths allow-list and back up data/.
DATA_DIR=/home/cvsz/zeaz/data
DATABASE_PATH=/home/cvsz/zeaz/data/moopiew.sqlite3
REQUIRE_ADMIN_KEY=true
ADMIN_KEY=replace-with-a-random-32-byte-secret
EMPLOYEE_KEY=replace-with-a-different-random-32-byte-secret
KITCHEN_KEY=replace-with-a-third-random-32-byte-secret
