# Production runtime configuration. Copy to .env.production and chmod 600.
PORT=8000
HOST=127.0.0.1
# Public hostnames served by the app router.
ZTTSHOP_HOSTNAME=zttshop.zeaz.dev
# SQLite is the supported durable database for this single-instance deployment.
# Keep both paths inside the systemd ReadWritePaths allow-list and back up data/.
DATA_DIR=/home/cvsz/zeaz/data
DATABASE_PATH=/home/cvsz/zeaz/data/moopiew.sqlite3
REQUIRE_ADMIN_KEY=true
# Enable only when the application port is inaccessible except through the
# loopback Cloudflare/Caddy proxy chain.
TRUST_CF_CONNECTING_IP=false
ADMIN_KEY=replace-with-a-random-32-byte-secret
EMPLOYEE_KEY=replace-with-a-different-random-32-byte-secret
KITCHEN_KEY=replace-with-a-third-random-32-byte-secret
# Generate independently with:
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
DOCUMENT_ENCRYPTION_KEY=replace-with-a-dedicated-fernet-key
DELETED_DOCUMENT_RETENTION_DAYS=30
# TikTok Login Kit credentials for zttshop. Leave blank until the app is
# registered in the TikTok developer console and the redirect URI is approved.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://zttshop.zeaz.dev/api/auth/tiktok/callback
TIKTOK_SCOPE=user.info.basic
